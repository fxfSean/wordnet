page {background:#F6F3EA;color:#172B25;font-family:sans-serif;font-size:30rpx}
.shell {padding:42rpx 36rpx 48rpx;box-sizing:border-box}
.kicker {color:#476458;font-size:23rpx;font-weight:700;letter-spacing:3rpx}
.title {display:block;font-family:Georgia,serif;font-size:78rpx;line-height:1.05;margin:14rpx 0 24rpx}
.muted {color:#476458;font-size:27rpx}
.paper {margin:32rpx 0;padding:32rpx;background:#FFFCF4;border:1rpx solid #DCDAD0;border-radius:22rpx}
button {margin:0;padding:18rpx 23rpx;border-radius:16rpx;line-height:1.45;font-size:29rpx;font-weight:700}
button::after {border:none}
.primary {background:#14634E;color:#FFF}
.secondary {background:#E5EBE0;color:#172B25}
.actions {display:flex;gap:16rpx;margin-top:18rpx}
.actions button {flex:1}
.row {display:flex;align-items:center;justify-content:space-between;gap:22rpx}
.sep {border-top:1rpx solid #DCDAD0;margin-top:21rpx;padding-top:21rpx}
.top-gap {margin-top:20rpx}
.compact {padding:10rpx 16rpx;font-size:24rpx}
.link-button {color:#14634E;font-size:27rpx;font-weight:700;text-decoration:underline}
.definition-zh {display:block;color:#476458;font-size:28rpx;margin-top:8rpx}
.translation {display:block;color:#476458;font-size:27rpx;margin-top:4rpx}
.example-block {margin-top:18rpx}
.note {display:block;margin-top:20rpx;padding:18rpx;background:#F2EFE4;border-radius:12rpx;color:#172B25;font-size:27rpx;line-height:1.5}
.tab-bar {white-space:nowrap;margin-top:20rpx;border-bottom:1rpx solid #DCDAD0;padding-bottom:12rpx}
.tab {display:inline-block;padding:8rpx 16rpx;margin-right:8rpx;border-radius:999rpx;background:#E5EBE0;color:#172B25;font-size:24rpx}
.tab.on {background:#14634E;color:#FFF}
.chips {display:flex;flex-wrap:wrap;gap:10rpx;margin-top:12rpx}
.chip {padding:6rpx 14rpx;background:#E5EBE0;border-radius:999rpx;font-size:25rpx}
.note-input {display:block;width:100%;min-height:200rpx;background:#FFFCF4;border:1rpx solid #DCDAD0;border-radius:16rpx;padding:18rpx;box-sizing:border-box;margin-top:18rpx;font-size:29rpx;line-height:1.5}
.entry {display:flex;align-items:center;justify-content:space-between;padding:19rpx 0;border-bottom:1rpx solid #DCDAD0}
.entry-meta {color:#476458;font-size:24rpx}
.chart {display:flex;align-items:flex-end;gap:6rpx;height:260rpx;margin-top:20rpx;padding-bottom:38rpx}
.bar-col {flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;height:100%;position:relative}
.bar {width:100%;max-width:28rpx;background:#14634E;border-radius:6rpx 6rpx 0 0;min-height:2rpx}
.bar-label {position:absolute;bottom:-34rpx;font-size:17rpx;color:#476458}
.gloss {display:block;font-family:Georgia,serif;font-size:50rpx;line-height:1.25;margin-top:22rpx;overflow-wrap:anywhere}
.answer {display:block;color:#14634E;font-size:61rpx;font-weight:700;overflow-wrap:anywhere}
.example {display:block;color:#476458;font-size:29rpx;margin-top:9rpx}
.search {background:#FFFCF4;border:1rpx solid #DCDAD0;border-radius:16rpx;padding:16rpx 22rpx;margin:25rpx 0}
.definition {display:block;font-size:35rpx;margin-top:10rpx}
.source {display:block;line-height:1.5;margin-top:28rpx;font-size:22rpx;color:#476458}
.feedback {display:block;margin-top:20rpx;color:#14634E;font-size:26rpx}
