page {
  background: #F6F3EA;
}

.library-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.word-hero {
  margin: -42rpx -36rpx 0;
  padding: 56rpx 36rpx 46rpx;
  border-radius: 0 0 38rpx 38rpx;
  color: #F4EFE2;
  background:
    radial-gradient(circle at 88% 6%, rgba(76, 130, 102, 0.72) 0, rgba(12, 24, 19, 0) 42%),
    linear-gradient(155deg, #0B1712 0%, #143126 58%, #1D3A2C 100%);
}

.word-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.word-hero-kicker {
  color: #C9B99A;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.word-hero-listen {
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(244, 239, 226, 0.28);
  border-radius: 999rpx;
  color: #F4EFE2;
  font-size: 21rpx;
}

.word-hero-word {
  display: block;
  margin-top: 28rpx;
  color: #F4EFE2;
  font-family: Georgia, serif;
  font-size: 92rpx;
  font-weight: 700;
  line-height: 1.05;
  overflow-wrap: anywhere;
}

.word-hero-meta {
  display: block;
  margin-top: 12rpx;
  color: #C9B99A;
  font-size: 22rpx;
}

.word-hero-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 28rpx;
}

.hero-button {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #E08A4A;
  color: #101815;
  font-size: 23rpx;
  font-weight: 700;
}

.hero-button.ghost {
  border: 1rpx solid rgba(244, 239, 226, 0.28);
  background: transparent;
  color: #F4EFE2;
}

.detail-card {
  position: relative;
  margin-top: -24rpx;
  border-radius: 26rpx;
  background: #FFFCF4;
  box-shadow: 0 18rpx 40rpx rgba(23, 43, 37, 0.08);
}

.sentence-card {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-left: 4rpx solid #E08A4A;
  border-radius: 0 16rpx 16rpx 0;
  background: #F8F4E9;
}

.sentence-en {
  display: block;
  color: #172B25;
  font-family: Georgia, serif;
  font-size: 31rpx;
  line-height: 1.45;
}

.sentence-zh {
  display: block;
  margin-top: 6rpx;
  color: #5E7067;
  font-size: 24rpx;
  line-height: 1.5;
}

.sentence-play {
  display: inline-block;
  color: #14634E;
  font-size: 21rpx;
  font-weight: 700;
}

.sentence-actions {
  display: flex;
  gap: 26rpx;
  margin-top: 10rpx;
}

.sentence-save {
  color: #8A6A4F;
  font-size: 21rpx;
}

.chip-warm {
  background: #F3DFCC;
  color: #7A4524;
}

.entry {
  padding: 20rpx 4rpx;
}

.entry-word {
  color: #172B25;
  font-family: Georgia, serif;
  font-size: 32rpx;
}

.empty-list {
  display: block;
  margin-top: 18rpx;
}

/* Paper / daylight theme */
.theme-light .word-hero {
  color: #172B25;
  background:
    radial-gradient(circle at 88% 6%, rgba(224, 138, 74, 0.2) 0, rgba(246, 243, 234, 0) 44%),
    linear-gradient(155deg, #FCFAF3 0%, #F5F0E2 58%, #EFE7D6 100%);
  box-shadow: inset 0 -1rpx 0 #E2DCCD;
}

.theme-light .word-hero-kicker,
.theme-light .word-hero-meta {
  color: #8A6A4F;
}

.theme-light .word-hero-word {
  color: #172B25;
}

.theme-light .word-hero-listen {
  border-color: #DCDAD0;
  background: #FFFCF4;
  color: #172B25;
}

.theme-light .hero-button.ghost {
  border-color: #DCDAD0;
  background: #FFFCF4;
  color: #172B25;
}

