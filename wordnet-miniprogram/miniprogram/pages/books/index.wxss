page {
  background: #F6F3EA;
}

.plan-page {
  padding-bottom: 80rpx;
}

.plan-intro {
  display: block;
  max-width: 620rpx;
  margin-top: -8rpx;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.shelf-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 4rpx 0 14rpx;
  color: #8A978F;
  font-size: 20rpx;
}

.shelf-selected {
  color: #14634E;
  font-weight: 700;
}

/* Horizontal bookshelf */
.shelf {
  width: 100%;
  height: 458rpx;
  white-space: nowrap;
  margin: 0;
  box-sizing: border-box;
}

.shelf-track {
  display: inline-block;
  padding: 48rpx 8rpx 10rpx;
  white-space: nowrap;
  vertical-align: top;
}

.book-card {
  display: inline-block;
  width: 248rpx;
  margin-right: 18rpx;
  vertical-align: top;
  white-space: normal;
}

.book {
  position: relative;
  display: flex;
  height: 340rpx;
  overflow: hidden;
  border-radius: 10rpx 22rpx 22rpx 10rpx;
  box-shadow: 0 16rpx 28rpx rgba(23, 43, 37, 0.16);
  opacity: 0.7;
  transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
}

.book-card.selected .book {
  transform: translateY(-18rpx) scale(1.04);
  box-shadow: 0 0 0 5rpx #E08A4A, 0 22rpx 40rpx rgba(23, 43, 37, 0.24);
  opacity: 1;
}

.book-spine {
  width: 18rpx;
  flex: none;
  background: rgba(0, 0, 0, 0.2);
  box-shadow: inset -2rpx 0 0 rgba(255, 255, 255, 0.14);
}

.book-face {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  padding: 24rpx 18rpx 20rpx;
  border-left: 1rpx solid rgba(255, 255, 255, 0.16);
}

.book-kicker {
  color: rgba(255, 255, 255, 0.7);
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.3;
  text-transform: uppercase;
}

.book-title {
  display: block;
  margin-top: 10rpx;
  color: #FFF;
  font-family: Georgia, serif;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.15;
  overflow-wrap: anywhere;
}

.book-count {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 18rpx;
}

.book-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #E08A4A;
  color: #101815;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2);
}

.book-progress {
  height: 4rpx;
  margin-top: 14rpx;
  border-radius: 4rpx;
  background: #E3DDCE;
  overflow: hidden;
}

.book-progress-fill {
  height: 100%;
  border-radius: 4rpx;
  background: #14634E;
}

.book-card.selected .book-progress-fill {
  background: #E08A4A;
}

.book-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 6rpx;
}

.book-studied {
  color: #8A978F;
  font-size: 18rpx;
}

.book-card.selected .book-studied {
  color: #C05A2E;
  font-weight: 700;
}

.book-current {
  color: #C05A2E;
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.cover-0 { background: linear-gradient(145deg, #0B3B2C, #2D6A4F); }
.cover-1 { background: linear-gradient(145deg, #4A2C1B, #A15C36); }
.cover-2 { background: linear-gradient(145deg, #1E2A4A, #3F5C9A); }
.cover-3 { background: linear-gradient(145deg, #4A1F2A, #9A4A5C); }
.cover-4 { background: linear-gradient(145deg, #2F3B1F, #7A8A3F); }
.cover-5 { background: linear-gradient(145deg, #2B1F3F, #6A4A9A); }
.cover-6 { background: linear-gradient(145deg, #3D2A14, #B07A3A); }
.cover-7 { background: linear-gradient(145deg, #1C3438, #3E7A82); }

/* Selected book summary */
.selected-card {
  padding: 28rpx;
}

.selected-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.selected-count {
  color: #8A978F;
  font-size: 20rpx;
}

.selected-title {
  display: block;
  margin-top: 14rpx;
  color: #172B25;
  font-family: Georgia, serif;
  font-size: 48rpx;
  line-height: 1.1;
}

.selected-sub {
  display: block;
  margin-top: 6rpx;
  color: #5E7067;
  font-size: 23rpx;
}

.selected-desc {
  display: block;
  margin-top: 12rpx;
  color: #5E7067;
  font-size: 23rpx;
  line-height: 1.5;
}

.selected-source {
  display: block;
  margin-top: 10rpx;
  color: #8A978F;
  font-size: 19rpx;
}

.save-plan {
  margin-top: 34rpx;
  width: 100%;
}

.theme-options {
  display: flex;
  gap: 10rpx;
}

.theme-option {
  padding: 8rpx 22rpx;
  border: 1rpx solid #DCDAD0;
  border-radius: 999rpx;
  background: #FFFCF4;
  color: #5E7067;
  font-size: 24rpx;
}

.theme-option.on {
  border-color: #14634E;
  background: #14634E;
  color: #FFF;
  font-weight: 700;
}
