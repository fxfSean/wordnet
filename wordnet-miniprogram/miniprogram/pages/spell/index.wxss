page {
  background: #0D1713;
}

.spell {
  min-height: 100vh;
  padding: 48rpx 36rpx 80rpx;
  box-sizing: border-box;
  color: #F4EFE2;
  background:
    radial-gradient(circle at 88% 6%, rgba(63, 117, 90, 0.55) 0, rgba(13, 23, 19, 0) 36%),
    radial-gradient(circle at 4% 80%, rgba(139, 77, 43, 0.42) 0, rgba(13, 23, 19, 0) 42%),
    linear-gradient(160deg, #08100D 0%, #0D1B16 58%, #172A21 100%);
}

.spell-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.spell-kicker {
  display: block;
  color: #C9B99A;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.spell-count {
  display: block;
  margin-top: 8rpx;
  color: #F4EFE2;
  font-family: Georgia, serif;
  font-size: 28rpx;
}

.spell-close {
  color: #C9B99A;
  font-size: 48rpx;
  line-height: 1;
  padding: 0 8rpx;
}

.spell-progress {
  height: 4rpx;
  margin-top: 22rpx;
  border-radius: 4rpx;
  background: rgba(244, 239, 226, 0.18);
  overflow: hidden;
}

.spell-progress-fill {
  height: 100%;
  border-radius: 4rpx;
  background: #E08A4A;
}

.spell-mode {
  display: flex;
  gap: 10rpx;
  margin-top: 28rpx;
}

.mode-tab {
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(244, 239, 226, 0.24);
  border-radius: 999rpx;
  color: #C9B99A;
  font-size: 22rpx;
}

.mode-tab.on {
  border-color: #E08A4A;
  background: rgba(224, 138, 74, 0.16);
  color: #F4EFE2;
}

.spell-stage {
  margin-top: 82rpx;
}

.spell-pos {
  color: #C9B99A;
  font-size: 21rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.spell-prompt {
  display: block;
  margin-top: 26rpx;
  color: #8FA99A;
  font-size: 23rpx;
}

.spell-definition {
  display: block;
  margin-top: 16rpx;
  color: #F4EFE2;
  font-family: Georgia, serif;
  font-size: 50rpx;
  line-height: 1.3;
}

.spell-replay {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 30rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid rgba(244, 239, 226, 0.24);
  border-radius: 999rpx;
  color: #F4EFE2;
  font-size: 24rpx;
}

.replay-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #E08A4A;
}

.spell-input {
  width: 100%;
  box-sizing: border-box;
  margin-top: 42rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(244, 239, 226, 0.28);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.07);
  color: #F4EFE2;
  font-family: Georgia, serif;
  font-size: 40rpx;
}

.spell-placeholder {
  color: #8FA99A;
  font-size: 26rpx;
}

.spell-feedback {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
}

.spell-feedback.good {
  color: #8FD0AE;
}

.spell-feedback.bad {
  color: #E08A4A;
}

.spell-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 34rpx;
}

.spell-check,
.spell-skip {
  flex: 1;
  padding: 24rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.spell-check {
  background: #E08A4A;
  color: #101815;
}

.spell-skip {
  border: 1rpx solid rgba(244, 239, 226, 0.24);
  background: rgba(244, 239, 226, 0.08);
  color: #F4EFE2;
}

.spell-empty {
  margin-top: 180rpx;
  text-align: center;
}

.spell-empty-title {
  display: block;
  color: #F4EFE2;
  font-family: Georgia, serif;
  font-size: 52rpx;
}

.spell-empty-body {
  display: block;
  margin: 16rpx 0 40rpx;
  color: #C9B99A;
  font-size: 25rpx;
}

.spell-top-right {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.spell-theme {
  padding: 8rpx 16rpx;
  border: 1rpx solid rgba(244, 239, 226, 0.24);
  border-radius: 999rpx;
  color: #C9B99A;
  font-size: 20rpx;
}

/* Paper / daylight theme */
.spell.theme-light {
  color: #172B25;
  background:
    radial-gradient(circle at 88% 6%, rgba(224, 138, 74, 0.18) 0, rgba(246, 243, 234, 0) 38%),
    radial-gradient(circle at 4% 80%, rgba(20, 99, 78, 0.12) 0, rgba(246, 243, 234, 0) 42%),
    linear-gradient(160deg, #FCFAF3 0%, #F6F3EA 58%, #EFE9DA 100%);
}

.spell.theme-light .spell-kicker {
  color: #8A6A4F;
}

.spell.theme-light .spell-count,
.spell.theme-light .spell-definition,
.spell.theme-light .spell-empty-title {
  color: #172B25;
}

.spell.theme-light .spell-close,
.spell.theme-light .spell-prompt,
.spell.theme-light .spell-empty-body {
  color: #5E7067;
}

.spell.theme-light .spell-progress {
  background: #E3DDCE;
}

.spell.theme-light .spell-progress-fill {
  background: #C05A2E;
}

.spell.theme-light .mode-tab {
  border-color: #DCDAD0;
  background: #FFFCF4;
  color: #5E7067;
}

.spell.theme-light .mode-tab.on {
  border-color: #C05A2E;
  background: rgba(192, 90, 46, 0.12);
  color: #7A4524;
}

.spell.theme-light .spell-pos {
  color: #476458;
}

.spell.theme-light .spell-replay {
  border-color: #DCDAD0;
  background: #FFFCF4;
  color: #172B25;
}

.spell.theme-light .replay-dot {
  background: #C05A2E;
}

.spell.theme-light .spell-input {
  border-color: #DCDAD0;
  background: #FFFCF4;
  color: #172B25;
}

.spell.theme-light .spell-placeholder {
  color: #8A978F;
}

.spell.theme-light .spell-feedback.good {
  color: #14634E;
}

.spell.theme-light .spell-feedback.bad {
  color: #C05A2E;
}

.spell.theme-light .spell-check {
  background: #14634E;
  color: #FFF;
}

.spell.theme-light .spell-skip {
  border-color: #DCDAD0;
  background: #FFFCF4;
  color: #172B25;
}

.spell.theme-light .spell-theme {
  border-color: #DCDAD0;
  background: #FFFCF4;
  color: #5E7067;
}

